---
/**
 * High-performance image for MDX. Imported (local) images are run through
 * Astro's image service (sharp) to emit modern formats, a responsive `srcset`
 * and intrinsic `width`/`height` (so there is zero layout shift). Lazy-loaded
 * and async-decoded by default; pass `priority` for above-the-fold hero images.
 *
 *   import hero from '../../assets/hero.png';
 *   <DocImage id="hero" src={hero} alt="…" caption="…" />
 *   <DocImage src="https://…/remote.png" alt="…" width={1200} height={630} />
 *
 * With an `id`, the caption is auto-numbered ("Figure 4.1.2") by the numbering
 * integration and the figure becomes referenceable with `<Ref id />`. As with
 * the other numbered blocks, `id` must be the FIRST attribute.
 *
 * Clicking the image opens a full-width overlay; Escape or a click dismisses it.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import numbering from 'virtual:numbering';

interface Props {
  /** Stable id for referencing + auto-numbering. Put it FIRST. Optional. */
  id?: string;
  /** Manual caption number, e.g. "4.1.2". Overridden by the auto-number when `id` is set. */
  number?: string;
  /** Caption label before the number. */
  label?: string;
  src: ImageMetadata | string;
  alt: string;
  width?: number;
  height?: number;
  /** Candidate widths for the responsive srcset (local images only). */
  widths?: number[];
  /** The `sizes` attribute describing the rendered width across breakpoints. */
  sizes?: string;
  /** Optional caption rendered under the image. */
  caption?: string;
  /** Load eagerly + high priority (use for the single LCP image only). */
  priority?: boolean;
  /** Set false to disable the click-to-enlarge overlay. */
  zoom?: boolean;
  class?: string;
}

const {
  id,
  number,
  label = 'Figure',
  src,
  alt,
  width,
  height,
  widths = [480, 800, 1200, 1600],
  sizes = '(max-width: 60rem) 100vw, 48rem',
  caption,
  priority = false,
  zoom = true,
  class: className,
} = Astro.props;

const isRemote = typeof src === 'string';
const loading = priority ? 'eager' : 'lazy';
const fetchpriority = priority ? 'high' : 'auto';

// Auto-number from the build-time map when an id is given; else fall back to
// the manually supplied `number` (or nothing).
const entry = id ? numbering.byId[id] : undefined;
const shownNumber = entry?.number ?? number;

// Caption alignment resolved per page by the notes doc route; defaults to
// centered (also the value used in blog/other contexts where it is unset).
const capAlign = Astro.locals.captionAlign?.figure ?? 'center';
---

<figure id={id} class:list={['doc-image', className]}>
  {/* A button, not a bare click handler, so the overlay is keyboard reachable. */}
  <Fragment>
    {zoom ? (
      <button type="button" class="doc-image__zoom" aria-label={`Enlarge image: ${alt}`}>
        {isRemote ? (
          <img
            src={src as string}
            alt={alt}
            width={width}
            height={height}
            loading={loading}
            decoding="async"
            fetchpriority={fetchpriority}
          />
        ) : (
          <Image
            src={src as ImageMetadata}
            alt={alt}
            widths={widths}
            sizes={sizes}
            loading={loading}
            decoding="async"
            fetchpriority={fetchpriority}
          />
        )}
      </button>
    ) : isRemote ? (
      <img
        src={src as string}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        decoding="async"
        fetchpriority={fetchpriority}
      />
    ) : (
      <Image
        src={src as ImageMetadata}
        alt={alt}
        widths={widths}
        sizes={sizes}
        loading={loading}
        decoding="async"
        fetchpriority={fetchpriority}
      />
    )}
  </Fragment>
  {(caption || shownNumber) && (
    <figcaption style={`text-align: ${capAlign};`}>
      {shownNumber && <strong>{label} {shownNumber}</strong>}
      {shownNumber && caption ? ' ' : ''}
      {caption}
    </figcaption>
  )}
</figure>

<script>
  // Click-to-enlarge. One delegated listener per page (Astro bundles this module
  // once no matter how many <DocImage> instances a page renders).
  function openLightbox(image: HTMLImageElement): void {
    const overlay = document.createElement('div');
    overlay.className = 'lightbox';

    const content = document.createElement('div');
    content.className = 'lightbox__content';

    const clone = image.cloneNode(true) as HTMLImageElement;
    clone.removeAttribute('loading');
    clone.removeAttribute('width');
    clone.removeAttribute('height');
    // The inline `sizes` describes the article column; in the overlay the image
    // fills the viewport, so widen it or the browser keeps the small variant.
    if (clone.srcset) {
      clone.sizes = '100vw';
    }
    content.appendChild(clone);
    overlay.appendChild(content);

    const close = () => {
      overlay.remove();
      document.removeEventListener('keydown', onKey);
    };
    const onKey = (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        close();
      }
    };
    overlay.addEventListener('click', close);
    document.addEventListener('keydown', onKey);
    document.body.appendChild(overlay);
  }

  document.addEventListener('click', (event) => {
    const trigger = (event.target as Element | null)?.closest?.('.doc-image__zoom');
    const image = trigger?.querySelector('img');
    if (image) {
      openLightbox(image);
    }
  });
</script>

<style>
  .doc-image {
    margin: 1.75rem 0;
  }
  .doc-image :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    background: var(--surface);
  }
  /* Neutralise the button so it lays out exactly like the bare image did. */
  .doc-image__zoom {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    cursor: zoom-in;
  }
  .doc-image figcaption {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>
