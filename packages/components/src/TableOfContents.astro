---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;

// Surface h2–h4 in the "On this page" rail.
const items = headings.filter((h) => h.depth >= 2 && h.depth <= 4);

// Track each heading's nearest shallower parent so an active sub-heading also
// lights up its ancestor line in the rail.
const parentOf = new Map<string, string>();
const stack: { depth: number; slug: string }[] = [];
for (const h of items) {
  while (stack.length && stack[stack.length - 1].depth >= h.depth) stack.pop();
  if (stack.length) parentOf.set(h.slug, stack[stack.length - 1].slug);
  stack.push({ depth: h.depth, slug: h.slug });
}
---

{items.length > 0 && (
  <nav class="toc" aria-labelledby="toc-title">
    <p class="toc-title" id="toc-title">On this page</p>
    <ul class="toc-list">
      {items.map((h) => (
        <li class:list={[`toc-l${h.depth}`]}>
          <a
            href={`#${h.slug}`}
            data-toc-link={h.slug}
            data-toc-parent={parentOf.get(h.slug)}
          >{h.text}</a>
        </li>
      ))}
    </ul>
    {/* Pinned to the bottom of the rail, so it stays reachable no matter how
        long the heading list is or how far down the article you are. */}
    <button type="button" class="toc-top" data-scroll-top>
      <span aria-hidden="true">↑</span> Back to top
    </button>
  </nav>
)}

<script>
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'),
  );
  if (links.length) {
    const byId = new Map(links.map((l) => [l.dataset.tocLink!, l]));
    const headings = links
      .map((l) => document.getElementById(l.dataset.tocLink!))
      .filter((el): el is HTMLElement => el !== null);

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            links.forEach((l) => l.classList.remove('active', 'parent-active'));
            const active = byId.get(entry.target.id);
            active?.classList.add('active');
            let parentId = active?.dataset.tocParent;
            // Walk up the ancestor chain so every parent line stays highlighted.
            while (parentId) {
              const parent = byId.get(parentId);
              parent?.classList.add('parent-active');
              parentId = parent?.dataset.tocParent;
            }
          }
        }
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 },
    );
    headings.forEach((h) => observer.observe(h));
  }

  document.querySelector('[data-scroll-top]')?.addEventListener('click', () => {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
  });
</script>

<style>
  /* A three-zone column: the title stays put, the heading list takes the
     remaining height and scrolls on its own when it doesn't fit, and "Back to
     top" pins to the bottom. The parent (`.doc-aside` / `.post-aside`) supplies
     the sticky position and the viewport-bound max-height. */
  .toc {
    display: flex;
    flex-direction: column;
    min-height: 0;
    max-height: 100%;
    border-left: 2px solid var(--border);
    padding-left: 1rem;
    font-size: 0.88rem;
  }
  .toc-title {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 0.75rem;
  }
  /* Pulled back to the rail's border so the active-item indicator lands on it,
     then padded again — which keeps the links inside the scroller's padding box
     and avoids the horizontal overflow a negative margin would otherwise cause. */
  .toc-list {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
    list-style: none;
    margin: 0 0 0 -1rem;
    padding: 0 0 0 1rem;
  }
  .toc li { margin: 0; }
  .toc-l3 { padding-left: 0.85rem; }
  .toc-l4 { padding-left: 1.7rem; }
  .toc a {
    display: block;
    padding: 0.3rem 0;
    color: var(--text-muted);
    line-height: 1.35;
    border-left: 2px solid transparent;
    margin-left: -1rem;
    padding-left: 1rem;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .toc a:hover { color: var(--text); }
  .toc a.active,
  .toc a.parent-active {
    color: var(--accent-text);
    border-color: var(--accent);
    font-weight: 600;
  }

  .toc-top {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    margin-top: 0.85rem;
    padding: 0.35rem 0;
    border: none;
    background: none;
    color: var(--text-muted);
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }
  .toc-top:hover { color: var(--accent-text); }

  @media (max-width: 60rem) {
    .toc {
      border-left: none;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1rem 1.25rem;
      background: var(--surface);
    }
    .toc-list { margin-left: 0; padding-left: 0; }
    .toc a { margin-left: 0; padding-left: 0.5rem; border-left: none; }
    .toc a.active,
    .toc a.parent-active { border-left: none; }
  }

  /* Below the rail breakpoint the TOC is a card above the article, where a
     "back to top" control would sit at the top of the page and be pointless. */
  @media (max-width: 75rem) {
    .toc-top { display: none; }
  }

  @media print {
    .toc-top { display: none; }
  }
</style>
