---
/**
 * PWA <head> tags + service-worker registration. Renders nothing unless the
 * site has `pwa.enabled` set. The manifest link and worker registration are
 * gated to production builds because `sw.js` / `manifest.webmanifest` are only
 * emitted by `astro build` (mirroring how Pagefind search is build-only).
 */
import { resolvePwa, type PwaSiteInfo } from './pwa';

type Props = PwaSiteInfo;

const resolved = resolvePwa(Astro.props);
const { enabled, manifest, themeColor, appleTouchIcon, precache } = resolved;
const isProd = import.meta.env.PROD;

// Worker registration. With precache on, the page also pings the worker to sync
// its precache on load and on every reconnect (while the tab is open), and asks
// for persistent storage so the offline cache resists eviction.
const registerScript = precache
  ? `if ('serviceWorker' in navigator) window.addEventListener('load', function () {
  navigator.serviceWorker.register('/sw.js').then(function (reg) {
    var sync = function () { navigator.serviceWorker.ready.then(function (r) { if (r.active) r.active.postMessage({ type: 'SYNC' }); }); };
    sync();
    addEventListener('online', sync);
    if (navigator.storage && navigator.storage.persist) navigator.storage.persist().catch(function () {});
  }).catch(function () {});
});`
  : `if ('serviceWorker' in navigator) window.addEventListener('load', function () { navigator.serviceWorker.register('/sw.js').catch(function () {}); });`;
---

{
  enabled && (
    <>
      <meta name="theme-color" content={themeColor} />
      <meta name="mobile-web-app-capable" content="yes" />
      <meta name="apple-mobile-web-app-capable" content="yes" />
      <meta name="apple-mobile-web-app-title" content={manifest.short_name} />
      {appleTouchIcon && <link rel="apple-touch-icon" href={appleTouchIcon} />}
      {isProd && (
        <>
          <link rel="manifest" href="/manifest.webmanifest" />
          <script is:inline set:html={registerScript} />
        </>
      )}
    </>
  )
}
