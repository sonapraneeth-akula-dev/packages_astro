---
/**
 * Injected print route (`/print/<notebook>`) — concatenates every page of a
 * notebook into one long, chrome-free document and auto-opens the browser
 * print dialog, so a whole handbook can be saved as a single PDF. Registered
 * only in notebooks mode; a curated `sidebar.json` (single-tree mode) yields
 * no print routes.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildNotebookPrintRoutes } from '../../utils/docs';
import { resolveCaptionAlign } from '../../config';
import { docsConfig } from 'virtual:notes-core/config';
import { components } from 'virtual:notes-core/components';
// KaTeX stylesheet for LaTeX math. Side-effect import (approach 1) so it works
// in dev and prod alike — see docs/math-rendering.md.
import 'katex/dist/katex.min.css';

export async function getStaticPaths() {
  if (!docsConfig.notebooks) return [];
  const entries = await getCollection('docs');
  return buildNotebookPrintRoutes(entries);
}

const { notebook, parts } = Astro.props;

// Flatten to every chapter, then render each page's Content up front, keyed by
// entry id so the part/chapter structure below can lay them out in order.
const chapters = parts.flatMap((part) => part.chapters);
// Every page opted out via `printInNotebook: false` — there is nothing to print,
// so the page explains that instead of opening an empty print dialog.
const isEmpty = chapters.length === 0;
const rendered = new Map(
  await Promise.all(
    chapters.map(
      async (ch) => [ch.entry.id, (await render(ch.entry)).Content] as const,
    ),
  ),
);
---

<BaseLayout
  config={docsConfig}
  title={`Print · ${notebook.label}`}
  description={notebook.description}
>
  <div class:list={['print-view container', { 'number-sections': docsConfig.printSectionNumbers !== false }]}>
    <header class="print-cover">
      <h1>
        {notebook.cover && <span class="print-cover-glyph" aria-hidden="true">{notebook.cover} </span>}
        {notebook.label}
      </h1>
      {notebook.description && <p class="print-lede">{notebook.description}</p>}
      {notebook.author && <p class="print-author">{notebook.author}</p>}
      {!isEmpty && (
        <p class="print-hint" data-pagefind-ignore>
          The print dialog opens automatically — choose “Save as PDF” to export
          the whole notebook, or close it to keep reading on screen.
        </p>
      )}
    </header>

    {isEmpty && (
      <dialog class="print-empty" data-print-empty data-pagefind-ignore>
        <h2>Nothing to print</h2>
        <p>
          Every page in <strong>{notebook.label}</strong> sets
          <code>printInNotebook: false</code> in its frontmatter, so this
          notebook has no printable pages and the print dialog was not opened.
        </p>
        <p>
          Remove that field (it defaults to <code>true</code>) from the pages you
          want in the PDF, then reload.
        </p>
        <form method="dialog" class="print-empty-actions">
          <a href={notebook.href}>Back to {notebook.label}</a>
          <button type="submit">Dismiss</button>
        </form>
      </dialog>
    )}

    {parts.map((part) => (
      <>
        {part.label && (
          <header class="print-part">
            {part.number && <p class="print-part-kicker">Part {part.number}</p>}
            <h2>{part.label}</h2>
          </header>
        )}
        {part.chapters.map(({ entry, number }) => {
          const Content = rendered.get(entry.id)!;
          // Per-page caption alignment (site default + per-page override).
          Astro.locals.captionAlign = {
            algorithm: resolveCaptionAlign('algorithm', docsConfig.captionAlign, entry.data.captionAlign),
            listing: resolveCaptionAlign('listing', docsConfig.captionAlign, entry.data.captionAlign),
            figure: resolveCaptionAlign('figure', docsConfig.captionAlign, entry.data.captionAlign),
          };
          return (
            <section class:list={['print-doc', { 'is-numbered': number }]}>
              <article class="doc">
                <header class="doc-head">
                  <h1>
                    {number && <span class="print-chapter-no">{number}. </span>}
                    {entry.data.cover && <span class="doc-cover" aria-hidden="true">{entry.data.cover} </span>}
                    {entry.data.title}
                  </h1>
                  {entry.data.description && <p class="doc-lede">{entry.data.description}</p>}
                </header>
                <div class="doc-body">
                  <Content components={components} />
                </div>
              </article>
            </section>
          );
        })}
      </>
    ))}
  </div>
</BaseLayout>

<script>
  // Open the print dialog once the page (fonts, math, images) has loaded — or,
  // when every page opted out of the book, explain that instead of printing.
  addEventListener('load', () => {
    const empty = document.querySelector<HTMLDialogElement>('[data-print-empty]');
    if (empty) empty.showModal();
    else window.print();
  });
</script>

<style>
  .print-view {
    padding-block: 2.5rem 4rem;
    max-width: 52rem;
  }
  .print-cover {
    padding-block: 1rem 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2.5rem;
  }
  .print-cover h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 0.5rem;
  }
  .print-lede {
    color: var(--text-muted);
    font-size: 1.15rem;
    max-width: 40rem;
  }
  .print-author {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: 0.25rem 0 0;
  }
  .print-hint {
    margin-top: 1.5rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    background: var(--surface-2, rgba(127, 127, 127, 0.08));
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .print-doc + .print-doc {
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border);
  }

  /* Empty-book notice, shown modally when no page opted into the print view. */
  .print-empty {
    max-width: 32rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
  }
  .print-empty::backdrop { background: rgb(0 0 0 / 0.5); }
  .print-empty h2 { margin: 0 0 0.75rem; font-size: 1.25rem; }
  .print-empty p { margin: 0 0 0.75rem; color: var(--text-muted); }
  .print-empty code {
    background: var(--bg-subtle);
    border-radius: 0.25rem;
    padding: 0.1em 0.35em;
  }
  .print-empty-actions {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: flex-end;
    margin-top: 1.25rem;
  }
  .print-empty-actions button {
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-subtle);
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .doc { min-width: 0; }
  .doc-head { margin-bottom: 1.5rem; }
  .doc-head h1 { margin: 0 0 0.5rem; }

  /* Tables: the print layout uses BaseLayout (not DocLayout), so it doesn't
     inherit DocLayout's bordered table styles — restate them here. */
  .print-doc :global(.doc-body table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
  }
  .print-doc :global(.doc-body th),
  .print-doc :global(.doc-body td) {
    border: 1px solid var(--border);
    padding: 0.6rem 0.85rem;
    text-align: left;
  }
  .print-doc :global(.doc-body th) { background: var(--bg-subtle); }

  /* Part divider (from a top-level sidebar group). */
  .print-part {
    margin-top: 3.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--text);
  }
  .print-part-kicker {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-text, var(--text-muted));
  }
  .print-part h2 {
    margin: 0.25rem 0 0;
    font-size: clamp(1.6rem, 3.5vw, 2.25rem);
  }
  .print-chapter-no { color: var(--text-muted); font-variant-numeric: tabular-nums; }

  /* Hierarchical section numbering for the in-page headings of numbered
     chapters (##/### → 1.1, 1.1.1 …), tracking each chapter's number. The
     content headings come from MDX (unscoped), so the descendant selectors are
     :global; the counters live on the scoped chapter wrappers. */
  .print-view { counter-reset: chap; }
  .print-doc.is-numbered { counter-increment: chap; }
  .print-doc.is-numbered :global(.doc-body) { counter-reset: sec; }
  .print-doc.is-numbered :global(.doc-body h2) { counter-increment: sec; counter-reset: sub; }
  .print-doc.is-numbered :global(.doc-body h3) { counter-increment: sub; counter-reset: subsub; }
  .print-doc.is-numbered :global(.doc-body h4) { counter-increment: subsub; }
  .number-sections .print-doc.is-numbered :global(.doc-body h2)::before {
    content: counter(chap) '.' counter(sec) '\2002';
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .number-sections .print-doc.is-numbered :global(.doc-body h3)::before {
    content: counter(chap) '.' counter(sec) '.' counter(sub) '\2002';
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .number-sections .print-doc.is-numbered :global(.doc-body h4)::before {
    content: counter(chap) '.' counter(sec) '.' counter(sub) '.' counter(subsub) '\2002';
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* Screen-only: no dialog on print, so drop the hint from the PDF. */
  @media print {
    .print-hint { display: none !important; }
    .print-view { max-width: none; padding: 0; }
    /* Start each chapter on a fresh page in the exported PDF. */
    .print-doc { break-before: page; }
    .print-cover { break-after: page; border-bottom: 0; }
    /* Begin every part on its own page, and never orphan its heading. */
    .print-part { break-before: page; break-after: avoid; }
    /* The part already forces a page break, so its first chapter shouldn't. */
    .print-part + .print-doc { break-before: auto; }
  }
</style>
