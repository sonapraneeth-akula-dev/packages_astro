---
/**
 * Injected per-notebook tags index route (`/<notebook>/tags`). The same
 * frequency-scaled cloud as the global `/tags`, but counting only the notes
 * inside one notebook. Registered in notebooks mode only.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLiveDocs, getTags, docsInNotebook } from '../../../utils/taxonomy';
import { getNotebooks, type Notebook } from '../../../utils/docs';
import type { Taxonomy } from '../../../utils/taxonomy';
import { docsConfig } from 'virtual:notes-core/config';

export const getStaticPaths = (async () => {
  const docs = await getLiveDocs();
  return getNotebooks(docs).map((notebook) => ({
    params: { notebook: notebook.id },
    props: { notebook, tags: getTags(docsInNotebook(docs, notebook.id)) },
  }));
}) satisfies GetStaticPaths;

const { notebook, tags } = Astro.props as { notebook: Notebook; tags: Taxonomy[] };

// Scale chip size by relative frequency for a tag-cloud feel.
const max = Math.max(1, ...tags.map((t) => t.count));
function scale(count: number): number {
  return 0.85 + (count / max) * 0.6; // rem font-size between ~0.85 and ~1.45
}
---

<BaseLayout
  config={docsConfig}
  title={`Tags · ${notebook.label}`}
  description={`Browse ${notebook.label} notes by tag.`}
>
  <div class="container page-head">
    <p class="eyebrow"><a href={notebook.href}>{notebook.label}</a> /</p>
    <h1>Tags</h1>
    <p class="lede">
      {tags.length} {tags.length === 1 ? 'tag' : 'tags'} in this notebook ·
      <a href="/tags">all tags across the site</a>
    </p>
  </div>

  <div class="container cloud">
    {tags.map((tag) => (
      <a
        class="cloud-tag"
        href={`${notebook.href}/tags/${tag.slug}`}
        style={`font-size:${scale(tag.count)}rem`}
      >
        {tag.name}
        <span class="ct">{tag.count}</span>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-bottom: 3rem;
    align-items: center;
  }
  .cloud-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-weight: 600;
    line-height: 1.2;
    transition: all 0.15s ease;
  }
  .cloud-tag:hover {
    color: var(--accent-text);
    border-color: var(--accent);
    background: var(--accent-soft);
    transform: translateY(-1px);
  }
  .ct {
    font-size: 0.7rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    background: var(--bg-subtle);
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
  }
  .page-head .eyebrow a,
  .page-head .lede a {
    color: var(--accent-text);
  }
</style>
