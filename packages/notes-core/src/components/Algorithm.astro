---
/**
 * Pseudocode / algorithm block for MDX prose — a booktabs-style float that
 * mimics the LaTeX `algorithm` + `algorithmicx` output (top/bottom rules, a
 * numbered caption, optional Input/Output, and auto-numbered body lines with
 * bold keywords and small-caps call names).
 *
 *   <Algorithm
 *     id="kmp"
 *     title="String pattern matching: Knuth-Morris-Pratt Algorithm"
 *     input="Input text(`text`) → string to search, Pattern(`pattern`)"
 *     output="List of indexes where the pattern matches"
 *     code={`function KMP(text, pattern)
 *     LPSArray ← COMPUTELPSARRAY(text, pattern)
 *     ...
 * end function`}
 *   />
 *
 * With an `id`, the caption number is assigned automatically (see the numbering
 * integration) as `[part.][chapter.]section[.subsection].n`. Indentation in
 * `code` is preserved verbatim (use spaces to nest blocks).
 */
import numbering from 'virtual:numbering';

interface Props {
  /** Stable id for referencing + auto-numbering. Put it FIRST. Optional. */
  id?: string;
  /** Manual caption number, e.g. "4.1.2". Overridden by the auto-number when `id` is set. */
  number?: string;
  /** Caption text after the number. */
  title: string;
  /** Caption label before the number. */
  label?: string;
  /** Optional "Input:" line (supports `backtick` inline code). */
  input?: string;
  /** Optional "Output:" line (supports `backtick` inline code). */
  output?: string;
  /** The pseudocode body — one statement per line; leading spaces = nesting. */
  code: string;
  /** First line number (default 1). */
  startLine?: number;
}

const { id, number, title, label = 'Algorithm', input, output, code, startLine = 1 } = Astro.props;

// Auto-number from the build-time map when an id is given; else fall back to
// the manually supplied `number` (or nothing).
const entry = id ? numbering.byId[id] : undefined;
const shownNumber = entry?.number ?? number;

const KEYWORDS = [
  'function', 'procedure', 'end', 'while', 'for', 'foreach', 'do', 'if', 'then',
  'else', 'elif', 'return', 'returns', 'break', 'continue', 'repeat', 'until',
];
const KEYWORD_RE = new RegExp(`\\b(${KEYWORDS.join('|')})\\b`, 'gi');
const CALL_RE = /\b([A-Z][A-Z0-9]{2,})\b/g; // ALL-CAPS run → small-caps call name

const escapeHtml = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

/** Escape, then style keywords (bold) and ALL-CAPS call names (small-caps). */
function formatCode(line: string): string {
  return escapeHtml(line)
    .replace(CALL_RE, '<span class="algo-call">$1</span>')
    .replace(KEYWORD_RE, '<strong>$1</strong>');
}

/** Escape prose and upgrade `backtick` spans to inline <code>. */
function formatProse(s: string): string {
  return escapeHtml(s).replace(/`([^`]+)`/g, '<code>$1</code>');
}

// Split the body into lines, trimming only the outer blank lines.
const lines = code.replace(/\t/g, '    ').split('\n');
while (lines.length && lines[0].trim() === '') lines.shift();
while (lines.length && lines[lines.length - 1].trim() === '') lines.pop();
const rows = lines.map((line, i) => ({ n: startLine + i, html: formatCode(line) }));
---

<figure id={id} class="algo" role="group" aria-label={`${label} ${shownNumber ?? ''} ${title}`.trim()}>
  <figcaption class="algo-cap">
    <strong>{label}{shownNumber ? ` ${shownNumber}` : ''}</strong>{' '}
    <span class="algo-title">{title}</span>
  </figcaption>

  {(input || output) && (
    <div class="algo-io">
      {input && (
        <p><span class="algo-io-key">Input:</span> <Fragment set:html={formatProse(input)} /></p>
      )}
      {output && (
        <p><span class="algo-io-key">Output:</span> <Fragment set:html={formatProse(output)} /></p>
      )}
    </div>
  )}

  <ol class="algo-body">
    {rows.map((r) => (
      <li class="algo-line" value={r.n}>
        <span class="algo-num" aria-hidden="true">{r.n}</span>
        <code class="algo-code" set:html={r.html} />
      </li>
    ))}
  </ol>
</figure>

<style>
  .algo {
    margin: 1.75rem 0;
    padding: 0;
    border-top: 2px solid var(--text);
    border-bottom: 2px solid var(--text);
    background: var(--surface);
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .algo-cap {
    padding: 0.6rem 1rem;
    font-family: var(--font-heading);
    font-size: 0.95rem;
  }
  .algo-cap .algo-title { font-weight: 400; }
  .algo-io {
    padding: 0.5rem 1rem;
    border-top: 1px solid var(--border);
  }
  .algo-io p { margin: 0.15rem 0; }
  .algo-io-key { font-weight: 700; }
  .algo-io :global(code),
  .algo-code :global(*),
  .algo-code {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
  }

  .algo-body {
    margin: 0;
    padding: 0.5rem 0 0.6rem;
    list-style: none;
    border-top: 1px solid var(--border);
  }
  .algo-line {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0 1rem;
  }
  .algo-num {
    flex: none;
    min-width: 1.75rem;
    text-align: right;
    color: var(--text-muted, #6b7280);
    font-variant-numeric: tabular-nums;
    user-select: none;
  }
  .algo-code {
    /* Preserve authored indentation; long lines wrap within the code column
       (aligned under the statement, not the number), like the LaTeX reference. */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
  }
  /* Neutralize the theme's inline-<code> pill (background/border/padding) so the
     pseudocode reads as plain booktabs text, like the LaTeX reference. */
  .algo :global(code) {
    background: none;
    border: 0;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
  }
  /* ALL-CAPS procedure/call names render as small-caps, like LaTeX \Call. */
  .algo-call {
    font-variant: small-caps;
    text-transform: lowercase;
  }
</style>
