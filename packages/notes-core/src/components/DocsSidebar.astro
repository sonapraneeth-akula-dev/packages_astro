---
/**
 * The left documentation sidebar: a sticky, scrollable navigation rail on
 * desktop and a collapsible drawer on mobile. The tree is generated by
 * `buildSidebar` (auto from folders/frontmatter, or a `sidebar.json` override).
 */
import type { SidebarNode } from '../utils/docs';
import SidebarTree from './SidebarTree.astro';
import Icon from '@sonapraneeth/components/Icon.astro';
import type { IconName } from '@sonapraneeth/components/icons';

interface Props {
  tree: SidebarNode[];
  currentPath: string;
  /** Heading shown above the tree (defaults to the site subject). */
  label?: string;
  /** Optional link back to the notebook hub (notebooks mode). */
  backLink?: { label: string; href: string };
  /** Taxonomy entry points rendered under the tree (tags, categories). */
  browse?: Array<{ label: string; href: string; icon: IconName }>;
}

const { tree, currentPath, label = 'Contents', backLink, browse = [] } = Astro.props;
---

<nav class="docs-sidebar" aria-label="Documentation navigation" data-pagefind-ignore>
  <button class="docs-sidebar-toggle" type="button" aria-expanded="false" aria-controls="docs-sidebar-panel">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
    <span>{label}</span>
  </button>
  <div class="docs-sidebar-panel" id="docs-sidebar-panel">
    {backLink && (
      <a class="docs-sidebar-back" href={backLink.href}>
        <span aria-hidden="true">←</span> {backLink.label}
      </a>
    )}
    <p class="docs-sidebar-label">{label}</p>
    <div class="docs-sidebar-scroll">
      <SidebarTree items={tree} currentPath={currentPath} />
    </div>
    {browse.length > 0 && (
      <div class="docs-sidebar-browse">
        <p class="docs-sidebar-label">Browse</p>
        <ul>
          {browse.map((link) => (
            <li>
              <a href={link.href} aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}>
                <Icon name={link.icon} />{link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</nav>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.docs-sidebar-toggle');
  const panel = document.getElementById('docs-sidebar-panel');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    panel?.classList.toggle('is-open', !open);
  });
  // Close the mobile drawer after navigating.
  panel?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a') && window.innerWidth <= 960) {
      toggle?.setAttribute('aria-expanded', 'false');
      panel.classList.remove('is-open');
    }
  });
</script>

<style>
  .docs-sidebar {
    font-size: 0.9rem;
  }
  .docs-sidebar-back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex: 0 0 auto;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    margin: 0 0 0.85rem;
    padding-left: 0.5rem;
  }
  .docs-sidebar-back:hover { color: var(--accent-text); }
  .docs-sidebar-label {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 0.75rem;
    padding-left: 0.5rem;
  }
  .docs-sidebar-scroll {
    overflow-y: auto;
  }
  .docs-sidebar-browse {
    flex: 0 0 auto;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .docs-sidebar-browse ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .docs-sidebar-browse a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
  }
  .docs-sidebar-browse a:hover,
  .docs-sidebar-browse a[aria-current='page'] {
    color: var(--accent-text);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  /* Desktop: sticky rail. The layout grid gives it the left column. The panel
     is bound to the viewport, so the back link + heading stay at the top, the
     Browse links stay at the bottom, and only the tree in between scrolls. */
  @media (min-width: 60.0625rem) {
    .docs-sidebar-toggle { display: none; }
    /* Fill the layout row so the sticky panel below can travel the full length
       of the article. Left at its content height, a short tree would scroll
       away long before the reader reached the end of the page. */
    .docs-sidebar { align-self: stretch; }
    .docs-sidebar-panel {
      position: sticky;
      top: var(--sticky-top);
      max-height: calc(100dvh - var(--sticky-top) - 1.5rem);
      display: flex;
      flex-direction: column;
    }
    /* `min-height: 0` is what actually makes this scroll: without it a flex
       item refuses to shrink below its content height, so the tree overflows
       the panel (and pushes Browse off-screen) instead of scrolling. */
    .docs-sidebar-scroll {
      flex: 1 1 auto;
      min-height: 0;
      overscroll-behavior: contain;
      scrollbar-gutter: stable;
      padding-right: 0.5rem;
    }
  }

  /* Mobile: a toggle button reveals the panel inline. */
  @media (max-width: 60rem) {
    .docs-sidebar-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      width: 100%;
      padding: 0.65rem 0.9rem;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--surface);
      color: var(--text);
      font-family: var(--font-heading);
      font-weight: 600;
      font-size: 0.95rem;
      cursor: pointer;
    }
    .docs-sidebar-label { display: none; }
    .docs-sidebar-panel {
      display: none;
      margin-top: 0.75rem;
      padding: 1rem;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--surface);
    }
    .docs-sidebar-panel.is-open { display: block; }
  }
</style>
